---
import { effectiveDisclosure, kindLabels, projectHref, type Project } from '../../lib/content';
import DisclosureBadge from './DisclosureBadge.astro';

interface Props { project: Project }
const { project: p } = Astro.props;
const disclosure = effectiveDisclosure(p);
---
<li class="prow" data-kind={p.data.kind} data-disc={disclosure}>
  <time class="prow__year">{p.data.year}</time>
  <div class="prow__main">
    <h3><a href={projectHref(p.id)}>{p.data.title}</a></h3>
    <p class="prow__sum">{p.data.summary}</p>
    {p.data.stack.length > 0 && <ul class="tags">{p.data.stack.map((s) => <li class="tag">{s}</li>)}</ul>}
  </div>
  <span class="prow__kind label">{kindLabels[p.data.kind]}</span>
  <DisclosureBadge disclosure={disclosure} />
</li>

<style>
  .prow { display: grid; grid-template-columns: 7rem 1fr 6.5rem 7.5rem; gap: 0.5rem 1.2rem; align-items: start; padding: 1rem 1rem 1rem 0.8rem; border-bottom: var(--line-w) solid var(--line); border-left: 2px solid transparent; transition: background var(--dur-fast), border-color var(--dur-fast); }
  .prow[hidden] { display: none; }
  .prow:hover, .prow:focus-within { background: var(--accent-soft); border-left-color: var(--accent); }
  .prow__year { font: 600 0.95rem var(--font-mono); font-variant-numeric: tabular-nums; color: var(--accent); text-shadow: var(--glow); padding-top: 0.1rem; }
  .prow__main { display: grid; gap: 0.4rem; min-width: 0; }
  .prow h3 { font-size: 1.05rem; letter-spacing: 0.1em; }
  .prow h3 a { color: var(--text); text-decoration: none; }
  .prow h3 a:hover { color: var(--accent); text-decoration: underline; }
  .prow__sum { font-size: var(--fs-sm); color: var(--text-2); max-width: 46rem; }
  .prow__kind { padding-top: 0.2rem; }
  .prow > :global(.badge) { justify-self: start; }
  @media (max-width: 860px) {
    .prow { grid-template-columns: 5.2rem 1fr; }
    .prow__kind, .prow > :global(.badge) { grid-column: 2; }
    .prow__kind { padding-top: 0; }
  }
</style>
