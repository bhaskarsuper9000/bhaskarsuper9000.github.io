---
import { defaultLens, lenses } from '../../data/lenses';
---
<div class="lens" role="group" aria-label="Focus the page on">
  {lenses.map((l) => <button type="button" class="lens__btn" data-lens-btn={l.id} aria-pressed={String(l.id === defaultLens)}>{l.label}</button>)}
</div>

<script>
  import '../../scripts/lens';
</script>

<style>
  .lens { display: inline-flex; border: var(--line-w) solid var(--line-strong); background: color-mix(in srgb, var(--bg) 70%, transparent); align-self: start; justify-self: start; }
  .lens__btn { min-height: 2.4rem; padding: 0.45rem 1rem; font: 600 0.75rem var(--font-head); text-transform: uppercase; letter-spacing: 0.14em; color: var(--text); background: none; border: 0; border-right: var(--line-w) solid var(--line); cursor: pointer; transition: background var(--dur-fast), color var(--dur-fast); }
  .lens__btn:last-child { border-right: 0; }
  .lens__btn:hover { color: var(--accent); background: var(--accent-soft); }
  .lens__btn[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); }
  .lens__btn:focus-visible { position: relative; z-index: 1; }
</style>
