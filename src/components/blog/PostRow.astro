---
import { formatDate, readingMinutes, type Post } from '../../lib/content';
interface Props { post: Post }
const { post } = Astro.props;
---
<li>
  <a class="panel post-row" href={`/blog/${post.id}/`}>
    <p class="label post-row__meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>{readingMinutes(post.body ?? '')} min read</span>
      {post.data.draft && <span class="post-row__draft">Draft</span>}
    </p>
    <h2>{post.data.title}</h2>
    <p class="post-row__sum">{post.data.summary}</p>
    {post.data.tags.length > 0 && <span class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</span>}
  </a>
</li>

<style>
  .post-row { display: grid; gap: 0.6rem; padding: 1.3rem 1.4rem; }
  .post-row__meta { display: flex; gap: 1.2rem; }
  .post-row__draft { color: var(--warn); }
  .post-row h2 { font-size: 1.25rem; letter-spacing: 0.06em; }
  .post-row:hover h2 { color: var(--accent); }
  .post-row__sum { color: var(--text-2); max-width: var(--measure); }
</style>
