---
// Corner-bracket frame. Styles: .panel in styles/components.css.
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> {
  as?: 'div' | 'section' | 'article' | 'aside' | 'li';
  tone?: 'warn' | 'quiet';
}
const { as: Tag = 'div', tone, class: className = '', ...rest } = Astro.props;
---
<Tag class:list={['panel', tone && `panel--${tone}`, className]} {...rest}><slot /></Tag>
