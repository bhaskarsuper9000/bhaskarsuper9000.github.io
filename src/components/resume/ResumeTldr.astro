---
// Interim compact TL;DR resume. Self-contained: replace this one folder's output to swap the concept.
import { site } from '../../data/site';
import { education, headline, more, roles, summary } from '../../data/resume';
import { getEras, getProjects } from '../../lib/content';
import PageHead from '../site/PageHead.astro';
import SectionHead from '../site/SectionHead.astro';
import RoleBlock from './RoleBlock.astro';
import MoreSection from './MoreSection.astro';
import SkillsBlock from './SkillsBlock.astro';
import RevealPanel from './RevealPanel.astro';

const [eras, projects] = await Promise.all([getEras(), getProjects()]);
const byId = new Map(projects.map((p) => [p.id, p]));
const slugs = [...new Set([...roles.flatMap((r) => r.bullets), ...more.flatMap((m) => m.items)].flatMap((b) => (b.slug ? [b.slug] : [])))];
const panelProjects = slugs.map((s) => byId.get(s)).filter((p): p is NonNullable<typeof p> => !!p);
---
<div class="wrap">
  <PageHead eyebrow="Resume · TL;DR" title={site.name} lead={summary}>
    <p class="links">
      <a href={site.github.url}>{site.github.label}</a>
      <a href={site.linkedin.url}>{site.linkedin.label}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
    <p class="actions">
      <a class="btn btn--primary" href={site.resumePdf} download>Download 1-page resume (PDF)</a>
      <a class="btn" href="/resume/classic/">Print-style version</a>
      <button class="btn btn--ghost" type="button" id="fold-all" aria-pressed="false">Collapse all</button>
    </p>
  </PageHead>

  <ul class="stats" aria-label="Headline numbers">
    {headline.map((h) => <li class="readout"><b class="readout__value">{h.value}</b><span class="readout__label">{h.label}</span></li>)}
  </ul>

  <div class="layout">
    <div class="col">
      <p class="legend label">Highlighted lines open their project: <b>&#9679;</b> text <b>&#9670;</b> diagram <b>&#9654;</b> demo <b>&#9675;</b> write-up</p>
      <section aria-labelledby="exp-h">
        <SectionHead n="01" title="Experience" id="exp-h" />
        <div class="roles">{roles.map((r) => <RoleBlock role={r} projects={byId} />)}</div>
      </section>
      <section aria-labelledby="edu-h">
        <SectionHead n="02" title="Education" id="edu-h" />
        <ul class="edu">
          {education.map((e) => <li><span><b>{e.school}</b> · {e.degree}</span><time>{e.dates}</time></li>)}
        </ul>
      </section>
      <section aria-labelledby="more-h">
        <SectionHead n="03" title="More" id="more-h" />
        <SkillsBlock />
        {more.map((m) => <MoreSection section={m} projects={byId} />)}
      </section>
    </div>
    <RevealPanel projects={panelProjects} eras={eras} />
  </div>
</div>

<script>
  const folds = [...document.querySelectorAll<HTMLDetailsElement>('details[data-fold]')];
  const btn = document.querySelector<HTMLButtonElement>('#fold-all')!;
  const sync = () => {
    const allOpen = folds.every((d) => d.open);
    btn.textContent = allOpen ? 'Collapse all' : 'Expand all';
    btn.setAttribute('aria-pressed', String(allOpen));
  };
  btn.addEventListener('click', () => { const open = !folds.every((d) => d.open); folds.forEach((d) => (d.open = open)); sync(); });
  folds.forEach((d) => d.addEventListener('toggle', sync));
  sync();
</script>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 0.3rem 1.4rem; font: var(--fs-sm) var(--font-mono); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.3rem; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-bottom: var(--space-4); }
  .stats .readout { padding: 0.6rem 0.9rem; }
  .stats .readout__value { order: -1; font-size: 1.5rem; color: var(--accent); }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; gap: 2.5rem; align-items: start; }
  .legend { margin-bottom: 1rem; }
  .legend b { color: var(--accent); margin: 0 0.2em 0 0.8em; }
  .roles { display: grid; gap: 1rem; }
  section + section { margin-top: var(--space-5); }
  .edu li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.25rem 0; }
  .edu time { font: var(--fs-xs) var(--font-mono); color: var(--text-2); white-space: nowrap; }
  @media (max-width: 959px) {
    .layout { display: block; }
    .stats { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) { .edu li { display: block; } .edu time { display: block; } }
</style>
