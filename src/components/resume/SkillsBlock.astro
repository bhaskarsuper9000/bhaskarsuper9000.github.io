---
import { skills, topSkills } from '../../data/resume';
const total = skills.reduce((n, g) => n + g.items.length, 0);
---
<details class="skills" data-fold>
  <summary>
    <b>Skills</b><span class="skills__top">{topSkills.join(' · ')}</span><span class="skills__more">+{total - topSkills.length} more</span>
  </summary>
  <dl>
    {skills.map((g) => (<><dt>{g.group}</dt><dd>{g.items.join(', ')}</dd></>))}
  </dl>
</details>

<style>
  .skills { border-top: var(--line-w) solid var(--line); padding: 0.6rem 0; }
  summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary b { font: 600 0.85rem var(--font-head); text-transform: uppercase; letter-spacing: 0.14em; }
  .skills__top { flex: 1; font-size: 0.9rem; }
  .skills__more { font: var(--fs-xs) var(--font-mono); color: var(--accent); }
  details[open] .skills__more { display: none; }
  dl { display: grid; grid-template-columns: 9rem 1fr; gap: 0.3rem 1rem; margin-top: 0.7rem; font-size: 0.9rem; }
  dt { font: 600 var(--fs-xs) var(--font-head); text-transform: uppercase; letter-spacing: var(--track-label); color: var(--text-2); padding-top: 0.2em; }
  @media (max-width: 520px) { dl { grid-template-columns: 1fr; } dt { padding-top: 0.5rem; } }
</style>
