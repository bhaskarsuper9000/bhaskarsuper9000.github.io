---
// Traditional one-page resume. Plain black on white in every site theme: the only place raw colours are allowed.
// No phone number, date of birth or grades. PDF: `npm run resume:pdf`.
import { site } from '../../data/site';
import { classicExtras, education, publications, roles, skills, summary } from '../../data/resume';
---
<div class="bar no-print wrap">
  <a class="btn btn--primary" href={site.resumePdf} download>Download PDF</a>
  <a class="btn" href="/resume/">Interactive version</a>
  <button class="btn btn--ghost" type="button" onclick="print()">Print</button>
</div>

<article class="paper" aria-label="Resume">
  <header>
    <h1>{site.name}</h1>
    <p class="sub">Software engineer · autonomous vehicles, robotics, simulation, platform &amp; data visualization</p>
    <p class="links">{site.github.label} · {site.linkedin.label} · {site.email}</p>
  </header>
  <p class="summary">{summary}</p>

  <section>
    <h2>Experience</h2>
    {roles.map((r) => (
      <div class="role">
        <p class="rh"><span><b>{r.org}</b> · {r.title}</span><time>{r.dates}</time></p>
        <ul>{r.bullets.map((b) => <li>{b.text}</li>)}</ul>
      </div>
    ))}
  </section>

  <section>
    <h2>Skills</h2>
    <dl>{skills.map((g) => (<><dt>{g.group}</dt><dd>{g.items.join(', ')}</dd></>))}</dl>
  </section>

  <section>
    <h2>Projects &amp; activities</h2>
    <dl>{classicExtras.map((x) => (<><dt>{x.label}</dt><dd>{x.text}</dd></>))}</dl>
  </section>

  <section>
    <h2>Education</h2>
    <ul class="edu">{education.map((e) => <li><span><b>{e.school}</b> · {e.degree}</span><time>{e.dates}</time></li>)}</ul>
  </section>

  <section>
    <h2>Publications</h2>
    <ul>{publications.map((p) => <li>{p}</li>)}</ul>
  </section>
</article>

<style>
  .bar { display: flex; flex-wrap: wrap; gap: 0.6rem; padding-top: var(--space-4); padding-bottom: var(--space-4); }
  .paper { width: min(8.5in, calc(100% - 2 * var(--pad))); margin: 0 auto; padding: 0.5in 0.55in; background: #fff; color: #000; font: 9.5pt / 1.3 "Liberation Sans", Arial, Helvetica, sans-serif; letter-spacing: 0; text-transform: none; box-shadow: 0 0 0 1px #888, 0 10px 40px rgb(0 0 0 / 0.35); }
  .paper :is(h1, h2, b, dt, time) { font-family: inherit; letter-spacing: 0; text-transform: none; }
  .paper a { color: inherit; }
  h1 { font-size: 20pt; font-weight: 700; line-height: 1.1; }
  .sub { margin-top: 2pt; font-size: 10pt; }
  .links { margin-top: 1pt; font-size: 9pt; }
  .summary { margin-top: 7pt; }
  h2 { margin: 9pt 0 3pt; padding-bottom: 1.5pt; border-bottom: 0.75pt solid #000; font-size: 9pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; }
  .role { margin-top: 4pt; }
  .rh, .edu li { display: flex; justify-content: space-between; gap: 12pt; }
  .rh time, .edu time { white-space: nowrap; }
  ul { margin: 1pt 0 0; padding-left: 12pt; list-style: disc; }
  ul.edu { padding: 0; list-style: none; }
  li { margin-top: 0.5pt; }
  dl { display: grid; grid-template-columns: 6.6em 1fr; gap: 1.5pt 8pt; }
  dt { font-weight: 700; }
  @media (max-width: 700px) { .paper { padding: 1rem; font-size: 10.5pt; } .rh, .edu li { display: block; } dl { grid-template-columns: 1fr; } dt { margin-top: 3pt; } }
  @media print {
    @page { size: Letter; margin: 0.4in 0.45in; }
    .paper { width: auto; margin: 0; padding: 0; box-shadow: none; font-size: 9pt; }
    .rh, .edu li { display: flex; }
    dl { grid-template-columns: 6.6em 1fr; }
  }
</style>
