---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Capabilities from '../components/home/Capabilities.astro';
import ExploreLinks from '../components/home/ExploreLinks.astro';
import { featuredProjects, getEras, getProjects } from '../lib/content';

const [eras, projects] = await Promise.all([getEras(), getProjects()]);
---
<BaseLayout>
  <Hero eras={eras} proofs={featuredProjects(projects)} />
  <Capabilities projects={projects} />
  <ExploreLinks />
</BaseLayout>
